# 统一以 LF 存储与检出，避免在 Windows 上换行被改写（.sh / .mjs / .py 均需 LF）
* text=auto eol=lf

# Windows 批处理必须是 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.onnx binary
*.pt binary
*.pkl binary
